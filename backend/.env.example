# Copy to backend/.env and fill in real values. Never commit .env.
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/smartlands
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000

# AI - any OpenAI-compatible provider (OpenAI, Groq, Gemini, OpenRouter, Ollama, ...)
# AI features are disabled until LLM_MODEL (and LLM_API_KEY for hosted providers) is set.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
